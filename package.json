{
  "name": "adflow",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/api/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"apps/api/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"*.json\"",
    "typecheck": "pnpm exec tsc -p packages/shared/tsconfig.json --noEmit && pnpm exec tsc -p packages/db/tsconfig.json --noEmit && pnpm exec tsc -p packages/chain/tsconfig.json --noEmit && pnpm exec tsc -p packages/agent-core/tsconfig.json --noEmit && pnpm exec tsc -p apps/api/tsconfig.json --noEmit",
    "dev": "pnpm --filter @adflow/api dev",
    "db:migrate": "pnpm --filter @adflow/db migrate",
    "contracts:compile": "pnpm --filter @adflow/contracts compile",
    "contracts:test": "pnpm --filter @adflow/contracts test",
    "smoke:testnet": "pnpm --filter @adflow/api smoke"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^4.0.4",
    "@types/node": "^24.10.0",
    "prettier": "^3.7.4"
  }
}
